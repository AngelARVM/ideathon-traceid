# Copiar a .env.local (git-ignored) y completar. Ver README.md.

# Requerida. Secreta (contiene una contraseña). Debe coincidir con docker-compose.yml.
DATABASE_URL="postgresql://traceid:traceid@localhost:54320/traceid"

# Firma la cookie de persona (docs/00-mvp-spec.md §7). Requerida en producción;
# en desarrollo se usa un valor fijo con un aviso. Generar con: openssl rand -base64 32
PERSONA_SECRET="replace-me-with-a-generated-value"
